# Copie este arquivo para .env.local e ajuste se precisar.
# (o .env.local fica fora do Git)

# Endereço da API de ocorrências (CRUD). Padrão: json-server local.
VITE_API_URL=http://localhost:3001

# De onde vêm as leituras de nível: simulada (CSV da pasta dados/) ou thingspeak
VITE_FONTE_LEITURAS=simulada

# Só para VITE_FONTE_LEITURAS=thingspeak
# Use a chave de LEITURA (Read API Key). Nunca coloque a chave de escrita aqui:
# tudo que começa com VITE_ fica visível no navegador.
VITE_THINGSPEAK_CANAL=
VITE_THINGSPEAK_CHAVE_LEITURA=
VITE_THINGSPEAK_RESULTADOS=200
