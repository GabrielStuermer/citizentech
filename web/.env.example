# Copie para .env.local e ajuste. Tudo com VITE_ fica visível no navegador.

# Endereço da API de ocorrências (json-server local)
VITE_API_URL=http://localhost:3001

# De onde vêm as leituras: simulada (CSV) ou thingspeak
VITE_FONTE_LEITURAS=simulada

# Canal do ThingSpeak (use só a chave de LEITURA)
VITE_THINGSPEAK_CANAL=
VITE_THINGSPEAK_CHAVE_LEITURA=
VITE_THINGSPEAK_RESULTADOS=200
