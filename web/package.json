{
  "name": "alerta-cheia-web",
  "private": true,
  "version": "0.1.0",
  "description": "App web do AlertaCheia: nível da água, alerta e ocorrências de alagamento no Humaitá (Porto Alegre)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node scripts/preparar-db.js && json-server --port 3001 db.json",
    "dev:tudo": "concurrently -n api,web -c blue,green \"npm run api\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "json-server": "^1.0.0-beta.15",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
